# ============================================================
# Variables para Docker Compose.
# Copiar a ".env" en docker/compose/ (o usar --env-file) para
# sobrescribir los defaults que ya traen los compose*.yaml.
# El archivo .env NO se versiona (ver .gitignore).
# ============================================================

# Version de la imagen publicada (fuente: docker/version/VERSION.txt).
VERSION=1.0.0

# Puerto publicado en el host (el contenedor siempre escucha en 3000).
HOST_PORT=3000

# Tag por defecto de la imagen en cada entorno no local.
STAGING_TAG=staging
PROD_TAG=latest
